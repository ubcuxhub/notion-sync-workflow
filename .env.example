# Copy to .env for local runs. Never commit .env.
#
# Internal Notion integration token (Settings -> Connections -> your integration).
# Both databases must be connected to this integration or every call 404s.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ids — the 32-hex-char segment of each database's URL.
# Dashes optional. These are resolved to data source ids at startup.
NOTION_TICKETS_DB=00000000000000000000000000000000
NOTION_PR_DB=00000000000000000000000000000000

# Needed only for local runs and for reconcile (which reads PRs across repos).
# In Actions this comes from the workflow's GITHUB_TOKEN.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to 1 to log intended writes without performing them.
DRY_RUN=
